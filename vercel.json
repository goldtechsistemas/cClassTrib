{
  "crons": [
    {
      "path": "/api/nfe-cron-sincronizar",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/nfe.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/nfe-empresas", "destination": "/api/nfe?rota=empresas" },
    { "source": "/api/nfe-certificado", "destination": "/api/nfe?rota=certificado" },
    { "source": "/api/nfe-empresa-excluir", "destination": "/api/nfe?rota=empresa-excluir" },
    { "source": "/api/nfe-sincronizar", "destination": "/api/nfe?rota=sincronizar" },
    { "source": "/api/nfe-cron-sincronizar", "destination": "/api/nfe?rota=cron-sincronizar" },
    { "source": "/api/nfe-manifestar", "destination": "/api/nfe?rota=manifestar" },
    { "source": "/api/nfe-documentos", "destination": "/api/nfe?rota=documentos" },
    { "source": "/api/nfe-exportar-xml", "destination": "/api/nfe?rota=exportar-xml" },
    { "source": "/api/nfe-exportar-excel", "destination": "/api/nfe?rota=exportar-excel" },
    { "source": "/api/nfe-exportar-pdf-lote", "destination": "/api/nfe?rota=exportar-pdf-lote" },
    { "source": "/api/nfe-exportar-pdf", "destination": "/api/nfe?rota=exportar-pdf" }
  ]
}
